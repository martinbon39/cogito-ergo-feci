{
  "$defs": {
    "AnswerArgs": {
      "description": "Provide a final answer / declare the task finished. Terminates the loop.\n\nFor state-based tasks, set ``content`` to a short summary of what was\nachieved. If the task is genuinely impossible, say so explicitly (e.g.\n\"the task is infeasible …\") and the harness will record a failure.",
      "properties": {
        "tool_name": {
          "const": "answer",
          "title": "Tool Name",
          "type": "string"
        },
        "content": {
          "description": "The final answer, or a summary of what was achieved",
          "title": "Content",
          "type": "string"
        }
      },
      "required": [
        "tool_name",
        "content"
      ],
      "title": "AnswerArgs",
      "type": "object"
    },
    "ClickArgs": {
      "description": "Click at (x, y) coordinates.",
      "properties": {
        "tool_name": {
          "const": "click",
          "title": "Tool Name",
          "type": "string"
        },
        "element": {
          "description": "Detailed description of the target UI element to click on",
          "title": "Element",
          "type": "string"
        },
        "x": {
          "description": "X coordinate as integer in [0, 1000]",
          "title": "X",
          "type": "integer"
        },
        "y": {
          "description": "Y coordinate as integer in [0, 1000]",
          "title": "Y",
          "type": "integer"
        }
      },
      "required": [
        "tool_name",
        "element",
        "x",
        "y"
      ],
      "title": "ClickArgs",
      "type": "object"
    },
    "DoubleClickArgs": {
      "description": "Double-click at (x, y) coordinates.",
      "properties": {
        "tool_name": {
          "const": "double_click",
          "title": "Tool Name",
          "type": "string"
        },
        "element": {
          "description": "Detailed description of the target UI element",
          "title": "Element",
          "type": "string"
        },
        "x": {
          "description": "X coordinate as integer in [0, 1000]",
          "title": "X",
          "type": "integer"
        },
        "y": {
          "description": "Y coordinate as integer in [0, 1000]",
          "title": "Y",
          "type": "integer"
        }
      },
      "required": [
        "tool_name",
        "element",
        "x",
        "y"
      ],
      "title": "DoubleClickArgs",
      "type": "object"
    },
    "DragArgs": {
      "description": "Drag from (x, y) to (to_x, to_y) with the left button held.",
      "properties": {
        "tool_name": {
          "const": "drag",
          "title": "Tool Name",
          "type": "string"
        },
        "x": {
          "description": "Start X in [0, 1000]",
          "title": "X",
          "type": "integer"
        },
        "y": {
          "description": "Start Y in [0, 1000]",
          "title": "Y",
          "type": "integer"
        },
        "to_x": {
          "description": "End X in [0, 1000]",
          "title": "To X",
          "type": "integer"
        },
        "to_y": {
          "description": "End Y in [0, 1000]",
          "title": "To Y",
          "type": "integer"
        }
      },
      "required": [
        "tool_name",
        "x",
        "y",
        "to_x",
        "to_y"
      ],
      "title": "DragArgs",
      "type": "object"
    },
    "HotkeyArgs": {
      "description": "Press a key combination together, e.g. ctrl+c or alt+Tab.",
      "properties": {
        "tool_name": {
          "const": "hotkey",
          "title": "Tool Name",
          "type": "string"
        },
        "keys": {
          "description": "Keys pressed together, e.g. ['ctrl','c'] or ['ctrl','shift','s']",
          "items": {
            "type": "string"
          },
          "title": "Keys",
          "type": "array"
        }
      },
      "required": [
        "tool_name",
        "keys"
      ],
      "title": "HotkeyArgs",
      "type": "object"
    },
    "PressKeyArgs": {
      "description": "Press a single keyboard key.",
      "properties": {
        "tool_name": {
          "const": "press_key",
          "title": "Tool Name",
          "type": "string"
        },
        "key": {
          "description": "A key name such as 'Enter', 'Tab', 'Escape', 'Backspace', 'ArrowUp', 'PageDown', or a single character like 'a'.",
          "title": "Key",
          "type": "string"
        }
      },
      "required": [
        "tool_name",
        "key"
      ],
      "title": "PressKeyArgs",
      "type": "object"
    },
    "RightClickArgs": {
      "description": "Right-click (open the context menu) at (x, y) coordinates.",
      "properties": {
        "tool_name": {
          "const": "right_click",
          "title": "Tool Name",
          "type": "string"
        },
        "element": {
          "description": "Detailed description of the target UI element",
          "title": "Element",
          "type": "string"
        },
        "x": {
          "description": "X coordinate as integer in [0, 1000]",
          "title": "X",
          "type": "integer"
        },
        "y": {
          "description": "Y coordinate as integer in [0, 1000]",
          "title": "Y",
          "type": "integer"
        }
      },
      "required": [
        "tool_name",
        "element",
        "x",
        "y"
      ],
      "title": "RightClickArgs",
      "type": "object"
    },
    "ScrollArgs": {
      "description": "Scroll the wheel at (x, y).",
      "properties": {
        "tool_name": {
          "const": "scroll",
          "title": "Tool Name",
          "type": "string"
        },
        "x": {
          "description": "X coordinate as integer in [0, 1000]",
          "title": "X",
          "type": "integer"
        },
        "y": {
          "description": "Y coordinate as integer in [0, 1000]",
          "title": "Y",
          "type": "integer"
        },
        "direction": {
          "description": "Scroll direction",
          "enum": [
            "up",
            "down",
            "left",
            "right"
          ],
          "title": "Direction",
          "type": "string"
        },
        "amount": {
          "default": 3,
          "description": "Number of scroll clicks (1-10)",
          "title": "Amount",
          "type": "integer"
        }
      },
      "required": [
        "tool_name",
        "x",
        "y",
        "direction"
      ],
      "title": "ScrollArgs",
      "type": "object"
    },
    "WaitArgs": {
      "description": "Wait for the screen to settle / a slow operation to finish.",
      "properties": {
        "tool_name": {
          "const": "wait",
          "title": "Tool Name",
          "type": "string"
        },
        "seconds": {
          "default": 3.0,
          "description": "How long to wait, in seconds. Use a few seconds for a quick settle, or more (e.g. 10-30) while a slow page or operation finishes, so you don't waste steps issuing wait repeatedly.",
          "title": "Seconds",
          "type": "number"
        }
      },
      "required": [
        "tool_name"
      ],
      "title": "WaitArgs",
      "type": "object"
    },
    "WriteArgs": {
      "description": "Type text into the currently focused element without clicking first.",
      "properties": {
        "tool_name": {
          "const": "write",
          "title": "Tool Name",
          "type": "string"
        },
        "content": {
          "description": "Content to write",
          "title": "Content",
          "type": "string"
        },
        "press_enter": {
          "default": false,
          "description": "Whether to press Enter after typing",
          "title": "Press Enter",
          "type": "boolean"
        }
      },
      "required": [
        "tool_name",
        "content"
      ],
      "title": "WriteArgs",
      "type": "object"
    }
  },
  "properties": {
    "note": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Task-relevant information from the current screen to remember (it persists across steps). Null if nothing new is worth keeping.",
      "title": "Note"
    },
    "thought": {
      "description": "One-line reasoning about the next action",
      "title": "Thought",
      "type": "string"
    },
    "tool_call": {
      "anyOf": [
        {
          "$ref": "#/$defs/ClickArgs"
        },
        {
          "$ref": "#/$defs/WriteArgs"
        },
        {
          "$ref": "#/$defs/AnswerArgs"
        },
        {
          "$ref": "#/$defs/DoubleClickArgs"
        },
        {
          "$ref": "#/$defs/RightClickArgs"
        },
        {
          "$ref": "#/$defs/PressKeyArgs"
        },
        {
          "$ref": "#/$defs/HotkeyArgs"
        },
        {
          "$ref": "#/$defs/ScrollArgs"
        },
        {
          "$ref": "#/$defs/DragArgs"
        },
        {
          "$ref": "#/$defs/WaitArgs"
        }
      ],
      "description": "The single action to take this step",
      "title": "Tool Call"
    }
  },
  "required": [
    "thought",
    "tool_call"
  ],
  "title": "_Step",
  "type": "object"
}
